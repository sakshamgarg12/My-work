# Copy to .env.local (or .env) and adjust if your API is not at the defaults below.
# CRA only reads variables prefixed with REACT_APP_.
# After any change: stop npm start and run it again (env is baked in at start).

# --- API base (fixes "Route not found" on login if this is wrong) ---
# Valid examples ONLY:
#   REACT_APP_API_URL=http://localhost:5000
#   REACT_APP_API_URL=http://localhost:5000/api
# Wrong (do not use):
#   .../api/auth   → login calls the wrong URL and Express returns 404
#
# Development (npm start):
#   Best: leave REACT_APP_API_URL unset — the app uses "/api" and package.json "proxy"
#   forwards to http://localhost:5000. (If you set REACT_APP_API_URL to localhost:5000,
#   the app still uses "/api" in dev so login URLs stay correct.)
#
# Production build (npm run build) or when not using the proxy:
#   Set one of the valid examples above so fetch() can reach the API (CORS is on).
#
# Server DB settings (DB_HOST, etc.) live in crm-app/server/.env — not here.

# REACT_APP_API_URL=http://localhost:5000

# Set to true to skip automatic dev JWT fetch (npm start only)
# REACT_APP_SKIP_DEV_TOKEN=true
